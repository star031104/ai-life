# 复制到 /etc/systemd/system/（路径、用户不一样就先改），然后：
#   sudo systemctl daemon-reload && sudo systemctl enable --now ai-life-wechat
# 代码在 /home/ubuntu/ailife/app（这个仓库），她的家在 app/home/wechat
# 要 root：读容器里微信进程的内存拿数据库密钥（/proc/<pid>/mem），以及 docker exec 发消息
[Unit]
Description=ai-life 微信群
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/home/ubuntu/ailife/app
Environment=PYTHONUTF8=1 PYTHONIOENCODING=utf-8
ExecStart=/home/ubuntu/ailife/app/.venv/bin/python run.py wechat
Restart=always
RestartSec=10
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
